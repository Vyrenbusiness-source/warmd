#!/usr/bin/env bash
# warmd: keep the slow thing warm. One command for build, test and screenshots, made for AI coding agents.
set -u
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
# WARMD_HOME without a process start: hooks run this for every tool call of every agent, and some Windows machines keep
# kernel memory for every process start until reboot. A clean absolute path is cut in bash, anything else goes through cd.
WARMD_HOME="${SELF//\\//}"
case "${OSTYPE:-}" in msys*) [[ $WARMD_HOME == [A-Za-z]:/* ]] && { _d="${WARMD_HOME:0:1}"; WARMD_HOME="/${_d,,}${WARMD_HOME:2}"; };; esac
if [[ $WARMD_HOME == /*/*/* && $WARMD_HOME != *//* && $WARMD_HOME != */./* && $WARMD_HOME != */../* && $WARMD_HOME != */. && $WARMD_HOME != */.. ]] && [ -d "${WARMD_HOME%/*}" ]; then
  WARMD_HOME="${WARMD_HOME%/*}"; WARMD_HOME="${WARMD_HOME%/*}"
else
  WARMD_HOME="$(cd "$(dirname "$SELF")/.." && pwd)"
fi
WARMD_VERSION=0.4.18
# A hook loads only what it needs: no other lib, no grep over lib/. PreToolUse (every tool call), SubagentStop and PreCompact.
case "${1:-}" in
  hook-pre|hook-subagent|hook-compact)
    CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/warmd"
    . "$WARMD_HOME/lib/platform.sh"; . "$WARMD_HOME/lib/auto.sh"; . "$WARMD_HOME/lib/hook.sh"
    hook_main "$@"; exit $?;;
esac
. "$WARMD_HOME/lib/platform.sh"
. "$WARMD_HOME/lib/core.sh"
. "$WARMD_HOME/lib/tune.sh"
. "$WARMD_HOME/lib/daemon.sh"
. "$WARMD_HOME/lib/ledger.sh"
. "$WARMD_HOME/lib/team.sh"
. "$WARMD_HOME/lib/handoff.sh"
. "$WARMD_HOME/lib/perf.sh"
. "$WARMD_HOME/lib/layout.sh"

# Commands register themselves: a lib calls reg with its name, usage line and function.
# New commands need no edit here, so parallel branches never conflict in this file.
REG_NAMES=" "; REG_USAGE=""
reg() { # name "usage line" function
  REG_NAMES="$REG_NAMES$1 "; REG_USAGE="$REG_USAGE  $2
"; eval "reg_fn_${1//-/_}=\$3"
}
# One grep for all libs, a process start per lib is slow on Windows.
# shellcheck source=/dev/null
while IFS= read -r f; do . "$f"; done < <(grep -l '^reg ' "$WARMD_HOME"/lib/*.sh)

usage() {
  cat <<EOF
warmd - keep the slow thing warm (Unity, Godot, web dev server, any test suite)

Everyday
  warmd status                 what was detected, what is warm
  warmd build                  fastest possible compile or typecheck
  warmd test [filter]          run tests, green results are cached by code hash
  warmd check                  build, then only the tests your change touches
  warmd bench [filter]         cold, warm and cached timings on your own project
  warmd shot [url|path]        desktop and phone screenshot, small enough for an agent
  warmd layout [url|path]      layout problems as text lines, no screenshot
  warmd run -- <cmd>           run anything, short output, raw log kept on disk
  warmd map [file]             repo map by import rank, or one outline with line numbers
  warmd audit                  what your agents really pay for, biggest first
  warmd stop [--force]         end the warm process for real, and other editors on this project

Agents
  warmd route <goal> [files]   cheapest fitting model tier
  warmd split <tasks.txt>      worktrees, models and one-line prompts for parallel agents
  warmd note "<one line>"      add a finding to the brief all agents of a batch share
  warmd escalate <name>        same task, next model tier
  warmd handoff <name> <done> <next>  context filling up: save state, get the line for a fresh agent
  warmd finish [--tokens N --calls N --outcome ok|escalated|failed]
                               record cost, push, print a one-line report
  warmd report                 cost per tier and what escalation wasted
  warmd board                  all worktrees at a glance
  warmd watch [minutes]        run in the background, ends when an agent stalls or the batch is over
  warmd merge <branch>         safe merge into the base branch, rolls back on red
  warmd merge --continue       finish a merge after you resolved its conflicts
  warmd batch-done             end the batch, the shared checkout opens again

Registered
${REG_USAGE}
Setup
  warmd init                   install the engine side, agent definitions, instructions and hooks
  warmd init --slim            also give project agents without a tools line the cheapest useful set
  warmd init --no-hooks        remove the hooks (--hooks installs only them)
  warmd doctor                 check what is missing
  warmd feedback               prefilled GitHub issue with your bench numbers, you decide
  warmd update                 fetch the newest version, only when you run it
  warmd package                build a player with your own method (Unity)

Options   -p <port>   --speed <N> (test time lapse, Unity)   --play | --edit | --window | --sound (Unity)
Env       WARMD_NOCACHE=1 (run even if cached)   WARMD_TIMEOUT=900   WARMD_PROJECT=<path>
Config    warmd.conf in the project root, every key in docs/COMMANDS.md
EOF
}

case "${1:-status}" in
  -h|--help|help) usage; exit 0;;
  -v|--version|version) echo "warmd $WARMD_VERSION"; exit 0;;
esac

CMD="${1:-status}"; [ $# -gt 0 ] && shift
# "warmd <cmd> --help" prints that command's usage lines, never runs it with --help as an argument.
case "${1:-}" in -h|--help) usage | grep -E "^ *warmd $CMD( |$)" || usage; exit 0;; esac
case "$CMD $*" in run\ *|hook-*|init\ *--hooks*|init\ *--no-hooks*) . "$WARMD_HOME/lib/hook.sh"; hook_main "$CMD" "$@"; exit $?;; esac
case "$REG_NAMES" in *" $CMD "*) fn="reg_fn_${CMD//-/_}"; "${!fn}" "$@"; exit $?;; esac
detect_project
# shellcheck source=/dev/null
. "$WARMD_HOME/adapters/$ADAPTER.sh"
case "$CMD" in test|check|build|bench|shot|layout|call|package|perf) run_mark;; esac

case "$CMD" in
  status)  common_status; install_behind; a_status;;
  build)   merge_guard; a_build;;
  test)    run_tests "$@";;
  check)   run_check;;
  bench)   run_bench "$@";;
  shot)    merge_guard; a_shot "$@";;
  layout)  merge_guard; layout_run "$@";;
  stop)    if [ "${1:-}" = --idle ] && r="$(run_active "$STATE")"; then echo "OK engine kept, warmd ${r#* } runs here (pid ${r%% *})"; else a_stop "$@"; fi;;
  ping)    job ping;;
  package) a_package;;
  call)    a_call "$@";;
  map)     case "${1:-}" in ""|--budget*) . "$WARMD_HOME/lib/map.sh"; repo_map "$@";; *) code_map "$@";; esac;;
  audit)   . "$WARMD_HOME/lib/context.sh"; common_audit; context_audit; mcp_audit;;
  feedback) common_feedback;;
  update)  common_update;;
  route)   route_print "$@";;
  split)   team_split "$@";;
  escalate) team_escalate "$@";;
  handoff) team_handoff "$@";;
  watch)   team_watch "$@";;
  note)    team_note "$@";;
  finish)  team_finish "$@";;
  report)  ledger_report "$@";;
  board)   team_board;;
  merge)   team_merge "$@";;
  perf)    perf_run "$@";;
  gain)    . "$WARMD_HOME/lib/gain.sh"; gain_run "$@";;
  batch-done) rm -f "$(git -C "$PROJECT" rev-parse --path-format=absolute --git-common-dir)/warmd-batch"; echo "OK batch ended";;
  init)    common_init; a_init; . "$WARMD_HOME/lib/hook.sh"; hook_install || echo "WARN hooks not installed, warmd works without them"; case "${1:-}" in --slim) . "$WARMD_HOME/lib/slim.sh"; slim_init;; esac;;
  doctor)  common_doctor; install_behind; a_doctor;;
  *) echo "warmd: unknown command '$CMD'"; usage | head -3; exit 2;;
esac
